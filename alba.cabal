cabal-version:  3.6
name:           alba
version:        0.1.0.0
category:       application
author:         albadsl@proton.me

extra-source-files:
    src/Alba/Vm/Common/Html/style.css
    src/Alba/Vm/Common/Html/script.js

common shared-properties
  default-language: GHC2021
  default-extensions:
      AllowAmbiguousTypes
      DataKinds
      DeriveAnyClass
      DuplicateRecordFields
      GADTs
      LambdaCase
      NoFieldSelectors
      OverloadedLabels
      OverloadedRecordDot
      OverloadedStrings
      OverloadedLists
      PatternSynonyms
      PartialTypeSignatures
      QuasiQuotes
      RecordWildCards
      TypeFamilies
      UndecidableInstances
  other-extensions: Strict TemplateHaskell MagicHash QuasiQuotes
  ghc-options: -fno-ignore-asserts -Wall -Werror
               -- Disable some warnings during development.
               -- -Wno-partial-type-signatures
               -- -Wno-unused-imports
               -- -Wno-unused-top-binds
               -- -Wno-unused-local-binds
               -- -Wno-unused-matches

  build-depends:
      aeson,
      aeson-pretty,
      array,
      base,
      base16,
      binary,
      blaze-html,
      blaze-markup,
      bytestring,
      containers,
      crypton,
      dhall,
      directory,
      entropy,
      file-embed,
      filepath,
      foldl,
      generic-lens,
      haskoin-core-bch-lite,
      here,
      -- liquidhaskell == 0.9.8.2, -- Disable for now.
      http-conduit,
      bchn-secp256k1,
      memory,
      microlens,
      mtl,
      optparse-applicative,
      pretty-simple,
      secp256k1-haskell,
      tasty,
      tasty-hunit,
      tasty-quickcheck,
      template-haskell,
      text,
      time,
      turtle,
      QuickCheck,
      vector

