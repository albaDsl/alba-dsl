executable alba
  import: shared-properties
  main-is: main.hs
  hs-source-dirs: apps/alba test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  other-modules: LibauthFileParse, LibauthSupport
  build-depends: alba, scientific

